#!/bin/zsh
# ─────────────────────────────────────────────────
# Livong — Project Management CLI
# Usage: ./livong <command>
# ─────────────────────────────────────────────────

set -e

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKEND_DIR="$ROOT_DIR/apps/backend"
WEB_DIR="$ROOT_DIR/apps/web"

# Env (don't export PORT — Next.js reads it and conflicts)
export DATABASE_URL="${DATABASE_URL:-postgres://$(whoami)@localhost:5432/livong?sslmode=disable}"
export JWT_SECRET="${JWT_SECRET:-test-secret-livong}"
BACKEND_PORT="${PORT:-8080}"
WEB_PORT="${WEB_PORT:-3000}"

# Colors
R='\033[0;31m' G='\033[0;32m' Y='\033[0;33m' B='\033[0;34m' C='\033[0;36m' NC='\033[0m' BOLD='\033[1m'

info()  { echo "${B}ℹ${NC} $1"; }
ok()    { echo "${G}✓${NC} $1"; }
warn()  { echo "${Y}⚠${NC} $1"; }
fail()  { echo "${R}✗${NC} $1"; }
title() { echo "\n${BOLD}${C}━━━ $1 ━━━${NC}\n"; }

# ── Helpers ──────────────────────────────────────

is_port_used() { lsof -ti:"$1" >/dev/null 2>&1; }

kill_port() {
  if is_port_used "$1"; then
    lsof -ti:"$1" | xargs kill -9 2>/dev/null
    sleep 1
    ok "Killed process on port $1"
  fi
}

# Open a new Terminal.app tab running a command
open_terminal_tab() {
  local tab_title="$1"
  local cmd="$2"
  osascript -e "
tell application \"Terminal\"
  activate
  do script \"printf '\\\\e]0;${tab_title}\\\\a' && ${cmd}\"
end tell"
}

# Close Terminal.app windows whose process matches
close_terminal_tab() {
  local port="$1"
  # The process on that port is already killed, so the terminal
  # window will show the shell prompt. We leave it for safety.
  # But we can close windows with matching title:
  local tab_title="$2"
  osascript -e "
tell application \"Terminal\"
  repeat with w in (every window)
    try
      if name of w contains \"${tab_title}\" then
        close w
      end if
    end try
  end repeat
end tell" 2>/dev/null || true
}

# ── Backend Commands ─────────────────────────────

backend_start() {
  title "Starting Backend"
  if is_port_used "$BACKEND_PORT"; then
    warn "Backend already running on :$BACKEND_PORT"
    return 0
  fi
  local cmd="cd '${BACKEND_DIR}' && PORT=${BACKEND_PORT} DATABASE_URL='${DATABASE_URL}' JWT_SECRET='${JWT_SECRET}' go run cmd/server/main.go"
  open_terminal_tab "Livong Backend" "$cmd"
  local attempts=0
  while ! is_port_used "$BACKEND_PORT" && [ $attempts -lt 20 ]; do
    sleep 1
    attempts=$((attempts + 1))
  done
  if is_port_used "$BACKEND_PORT"; then
    ok "Backend running on :$BACKEND_PORT (new terminal)"
  else
    fail "Backend failed to start (waited ${attempts}s)"
    return 1
  fi
}

backend_stop() {
  title "Stopping Backend"
  if is_port_used "$BACKEND_PORT"; then
    kill_port "$BACKEND_PORT"
    close_terminal_tab "$BACKEND_PORT" "Livong Backend"
    ok "Backend stopped & terminal closed"
  else
    warn "Backend not running"
  fi
}

backend_restart() {
  title "Restarting Backend"
  backend_stop
  backend_start
}

backend_logs() {
  title "Backend Logs"
  if is_port_used "$BACKEND_PORT"; then
    info "Backend is running on :$BACKEND_PORT"
    lsof -ti:"$BACKEND_PORT" | head -1 | xargs ps -p 2>/dev/null || true
  else
    warn "Backend not running"
  fi
}

# ── Web Commands ─────────────────────────────────

web_dev() {
  title "Starting Web (dev)"
  if is_port_used "$WEB_PORT"; then
    warn "Web already running on :$WEB_PORT"
    return 0
  fi
  local cmd="cd '${WEB_DIR}' && PORT=${WEB_PORT} pnpm dev"
  open_terminal_tab "Livong Frontend" "$cmd"
  local attempts=0
  while ! is_port_used "$WEB_PORT" && [ $attempts -lt 20 ]; do
    sleep 1
    attempts=$((attempts + 1))
  done
  if is_port_used "$WEB_PORT"; then
    ok "Web dev server on :$WEB_PORT (new terminal)"
  else
    fail "Web failed to start"
    return 1
  fi
}

web_stop() {
  title "Stopping Web"
  if is_port_used "$WEB_PORT"; then
    kill_port "$WEB_PORT"
    close_terminal_tab "$WEB_PORT" "Livong Frontend"
    ok "Web stopped & terminal closed"
  else
    warn "Web not running"
  fi
}

web_restart() {
  title "Restarting Web (dev)"
  web_stop
  web_dev
}

web_build() {
  title "Building Web (production)"
  cd "$WEB_DIR"
  pnpm build
  ok "Build complete → $WEB_DIR/.next"
}

web_prod() {
  title "Starting Web (production)"
  if is_port_used "$WEB_PORT"; then
    warn "Port $WEB_PORT in use — stopping first"
    kill_port "$WEB_PORT"
    close_terminal_tab "$WEB_PORT" "Livong Frontend"
  fi
  if [ ! -d "$WEB_DIR/.next" ]; then
    warn "No build found, building first..."
    web_build
  fi
  local cmd="cd '${WEB_DIR}' && PORT=${WEB_PORT} pnpm start"
  open_terminal_tab "Livong Frontend" "$cmd"
  local attempts=0
  while ! is_port_used "$WEB_PORT" && [ $attempts -lt 10 ]; do
    sleep 1
    attempts=$((attempts + 1))
  done
  if is_port_used "$WEB_PORT"; then
    ok "Web production server on :$WEB_PORT (new terminal)"
  else
    fail "Web production failed to start"
    return 1
  fi
}

web_clean() {
  title "Cleaning Web"
  cd "$WEB_DIR"
  rm -rf .next
  ok "Cleared .next cache"
}

web_lint() {
  title "Linting Web"
  cd "$WEB_DIR"
  pnpm lint
}

web_install() {
  title "Installing Web Dependencies"
  cd "$WEB_DIR"
  pnpm install
  ok "Dependencies installed"
}

# ── Combined Commands ────────────────────────────

start_all() {
  backend_start
  web_dev
  status
}

stop_all() {
  backend_stop
  web_stop
}

restart_all() {
  stop_all
  start_all
}

status() {
  title "Status"
  if is_port_used "$BACKEND_PORT"; then
    ok "Backend  → ${G}running${NC} on :$BACKEND_PORT"
  else
    fail "Backend  → ${R}stopped${NC}"
  fi
  if is_port_used "$WEB_PORT"; then
    ok "Frontend → ${G}running${NC} on :$WEB_PORT"
  else
    fail "Frontend → ${R}stopped${NC}"
  fi
}

fresh() {
  title "Fresh Start"
  stop_all
  web_clean
  web_install
  start_all
}

# ── Interactive Menu ──────────────────────────────

interactive_menu() {
  while true; do
    echo ""
    echo "${BOLD}${C}━━━ Livong CLI ━━━${NC}"
    echo ""

    # Show live status
    if is_port_used "$BACKEND_PORT"; then
      echo "  Backend  → ${G}● running${NC} :$BACKEND_PORT"
    else
      echo "  Backend  → ${R}○ stopped${NC}"
    fi
    if is_port_used "$WEB_PORT"; then
      echo "  Frontend → ${G}● running${NC} :$WEB_PORT"
    else
      echo "  Frontend → ${R}○ stopped${NC}"
    fi

    echo ""
    echo "${BOLD}  Pick a command:${NC}"
    echo ""
    echo "  ${G}1)${NC}  Start everything"
    echo "  ${G}2)${NC}  Stop everything"
    echo "  ${G}3)${NC}  Restart everything"
    echo "  ${G}4)${NC}  Fresh start (clean + install + start)"
    echo ""
    echo "  ${B}5)${NC}  Start backend"
    echo "  ${B}6)${NC}  Stop backend"
    echo "  ${B}7)${NC}  Restart backend"
    echo ""
    echo "  ${Y}8)${NC}  Start frontend (dev)"
    echo "  ${Y}9)${NC}  Stop frontend"
    echo "  ${Y}10)${NC} Restart frontend"
    echo "  ${Y}11)${NC} Build frontend (production)"
    echo "  ${Y}12)${NC} Clean .next cache"
    echo "  ${Y}13)${NC} Install dependencies"
    echo ""
    echo "  ${R}0)${NC}  Exit"
    echo ""
    printf "  ${BOLD}→ ${NC}"
    read -r choice

    case "$choice" in
      1)  start_all ;;
      2)  stop_all ;;
      3)  restart_all ;;
      4)  fresh ;;
      5)  backend_start ;;
      6)  backend_stop ;;
      7)  backend_restart ;;
      8)  web_dev ;;
      9)  web_stop ;;
      10) web_restart ;;
      11) web_build ;;
      12) web_clean ;;
      13) web_install ;;
      0|q|quit|exit)
        echo ""
        ok "Bye! 👋"
        echo ""
        exit 0
        ;;
      *)
        warn "Invalid choice — try again"
        ;;
    esac
  done
}

# ── Router ───────────────────────────────────────

case "${1:-}" in
  server:start)   backend_start ;;
  server:stop)    backend_stop ;;
  server:restart) backend_restart ;;
  server:logs)    backend_logs ;;
  web:dev)        web_dev ;;
  web:stop)       web_stop ;;
  web:restart)    web_restart ;;
  web:build)      web_build ;;
  web:prod)       web_prod ;;
  web:clean)      web_clean ;;
  web:lint)       web_lint ;;
  web:install)    web_install ;;
  start)          start_all ;;
  stop)           stop_all ;;
  restart)        restart_all ;;
  status)         status ;;
  fresh)          fresh ;;
  menu|interactive) interactive_menu ;;
  help|--help|-h|"") interactive_menu ;;
  *)
    fail "Unknown command: $1"
    usage
    exit 1
    ;;
esac
